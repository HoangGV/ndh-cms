# Cloudflare / Server GitHub Publishing Configuration
# Keep GITHUB_TOKEN strictly on the server (never prefix with VITE_).
# On Cloudflare Workers, set via: npx wrangler secret put GITHUB_TOKEN
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-blog-repo
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=src/content/blog
BLOG_DOMAIN=https://ndh.io.vn

# Session Signing Secret (min 32 random chars in production)
# On Cloudflare Workers, set via: npx wrangler secret put JWT_SECRET
JWT_SECRET=

# Local SQLite database file path for local Node preview (unused on Cloudflare D1)
LOCAL_DB_PATH=.local-cms.sqlite
